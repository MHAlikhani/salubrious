{
  "name": "salubrious",
  "version": "0.1.5",
  "description": "Know the health of your dependency tree before it kills your build.",
  "author": "Mohammad Hossein Alikhani <mohammad.hossein.alikhani@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "salubrious": "./dist/cli.cjs"
  },
  "files": [
    "dist/",
    ".github/action/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "release": "npm publish --access=public",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MHAlikhani/salubrious.git"
  },
  "bugs": {
    "url": "https://github.com/MHAlikhani/salubrious/issues"
  },
  "homepage": "https://github.com/MHAlikhani/salubrious#readme",
  "keywords": [
    "dependency",
    "health",
    "security",
    "audit",
    "maintenance",
    "abandoned",
    "supply-chain",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "biome": "^0.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2"
}
